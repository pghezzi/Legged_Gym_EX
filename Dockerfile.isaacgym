# syntax=docker/dockerfile:1
# =============================================================================
# LeggedGym-Ex Dockerfile (IsaacGym)
# =============================================================================
# 构建命令：
#   cd /path/to/Legged_Gym_EX
#   docker buildx build --load \
#     --build-context isaacgym=/path/to/isaacgym \
#     -t leggedgym-ex:isaacgym -f Dockerfile.isaacgym .
#
# 运行命令：
#   docker run --gpus all -it --rm leggedgym-ex:isaacgym

# ---- 基础镜像 ----
FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04

# ---- 复制 uv 工具 ----
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ---- 环境变量 ----
ENV DEBIAN_FRONTEND=noninteractive
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_PREFERENCE=only-managed
ENV UV_HTTP_TIMEOUT=300

# ---- 安装系统依赖 ----
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    libegl-dev \
    libgl1-mesa-glx \
    libglu1-mesa \
    libvulkan-dev \
    vulkan-tools \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    python3-pip \
    bash-completion \
    vim \
    && rm -rf /var/lib/apt/lists/*

# ---- 配置 PyPI 镜像源 ----
RUN python3 -m pip config set global.index-url \
    https://pypi.tuna.tsinghua.edu.cn/simple
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 安装 Python 3.8 ----
RUN uv python install 3.8

# ---- 创建工作目录 ----
WORKDIR /workspace

# ---- 复制 IsaacGym ----
COPY --from=isaacgym / /workspace/isaacgym

# ---- 复制项目源码 ----
COPY . /workspace/LeggedGym-Ex

# ---- 创建并安装 IsaacGym 环境 ----
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /workspace/LeggedGym-Ex && \
    uv venv --python 3.8 .venv && \
    . .venv/bin/activate && \
    uv pip install torch==2.4.1+cu121 torchvision==0.19.1+cu121 \
        --index-url https://download.pytorch.org/whl/cu121 && \
    cd /workspace/isaacgym/python && \
    find . -type f -name "*.py" -exec sed -i 's/np\.float/np.float32/g' {} + && \
    uv pip install -e . && \
    cd /workspace/LeggedGym-Ex && \
    uv pip install ".[isaacgym]" && \
    uv pip install -e .

# ---- 配置环境变量 ----
ENV SIMULATOR=isaacgym
ENV PYTHONPATH=/workspace/LeggedGym-Ex:$PYTHONPATH
ENV PATH=/workspace/LeggedGym-Ex/.venv/bin:$PATH
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# ---- 默认命令 ----
CMD ["bash"]
