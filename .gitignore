# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# ignore pytorch checkpoint files
*.pt

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.tiff
*.avi
*.flv
*.mov
*.wmv
*.zip

# VS Code
.vscode
# logs
*logs*/
exp_logs/
depth_waq_selector/
runs/

# other
*.egg-info
__pycache__
wandb
build
*debug*
resources/terrains/*.stl


# Local pretrained models and teacher checkpoints
local_checkpoints_waq_distill/
.env
.env.*
!.env.example

paper_locomotion_eval
paper_offline_eval
